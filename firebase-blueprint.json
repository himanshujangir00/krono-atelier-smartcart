{
  "entities": {
    "User": {
      "title": "User",
      "description": "Authenticated shopper or store admin profile with preference tags and purchased product IDs.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 100 },
        "role": { "type": "string", "enum": ["customer", "admin"] },
        "preferences": { "type": "array" },
        "purchasedProductIds": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "name", "role", "preferences", "purchasedProductIds", "createdAt", "updatedAt"]
    },
    "UserPrivateInfo": {
      "title": "UserPrivateInfo",
      "description": "Isolated PII document containing user email and default shipping address.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "email": { "type": "string", "minLength": 3, "maxLength": 200 },
        "defaultShippingAddress": { "type": "string", "maxLength": 300 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "updatedAt"]
    },
    "Admin": {
      "title": "Admin",
      "description": "Trusted roster of authorized store administrator UIDs.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "email": { "type": "string", "minLength": 3, "maxLength": 200 },
        "grantedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "grantedAt"]
    },
    "Product": {
      "title": "Product",
      "description": "Storefront catalog product indexed by HashMap, MaxHeap, Graph, and Search modules.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "sku": { "type": "string", "minLength": 2, "maxLength": 40 },
        "name": { "type": "string", "minLength": 2, "maxLength": 140 },
        "category": { "type": "string", "minLength": 2, "maxLength": 60 },
        "price": { "type": "number" },
        "rating": { "type": "number" },
        "reviewCount": { "type": "number" },
        "salesCount": { "type": "number" },
        "stock": { "type": "number" },
        "tags": { "type": "array" },
        "material": { "type": "string", "maxLength": 160 },
        "dimensions": { "type": "string", "maxLength": 80 },
        "description": { "type": "string", "maxLength": 1000 },
        "imageUrl": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "sku", "name", "category", "price", "rating", "reviewCount", "salesCount", "stock", "tags", "material", "dimensions", "description", "imageUrl", "createdAt", "updatedAt"]
    },
    "Category": {
      "title": "Category",
      "description": "Catalog product category.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "minLength": 2, "maxLength": 60 },
        "description": { "type": "string", "maxLength": 300 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "description", "createdAt", "updatedAt"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer purchase order with bounded line items and server-validated ownership.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "customerName": { "type": "string", "minLength": 2, "maxLength": 120 },
        "customerEmail": { "type": "string", "minLength": 3, "maxLength": 200 },
        "shippingAddress": { "type": "string", "minLength": 5, "maxLength": 300 },
        "items": { "type": "array" },
        "subtotal": { "type": "number" },
        "shippingFee": { "type": "number" },
        "total": { "type": "number" },
        "status": { "type": "string", "enum": ["Confirmed", "Preparing Shipment", "Shipped"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "customerName", "customerEmail", "shippingAddress", "items", "subtotal", "shippingFee", "total", "status", "createdAt", "updatedAt"]
    },
    "CartItem": {
      "title": "CartItem",
      "description": "Persistent shopping cart item scoped to its owner.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "productId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "quantity": { "type": "number" },
        "addedAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "productId", "quantity", "addedAt", "updatedAt"]
    },
    "WishlistItem": {
      "title": "WishlistItem",
      "description": "User saved product wishlist entry.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "productId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "addedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "productId", "addedAt"]
    },
    "BrowsingHistory": {
      "title": "BrowsingHistory",
      "description": "Tracked product view record for personalized recommendations.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "productId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "category": { "type": "string", "minLength": 1, "maxLength": 60 },
        "viewCount": { "type": "number" },
        "lastViewedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "productId", "category", "viewCount", "lastViewedAt"]
    },
    "RecommendationSnapshot": {
      "title": "RecommendationSnapshot",
      "description": "Persisted personalized product recommendations computed via Set/Graph DSA.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "items": { "type": "array" },
        "computedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "items", "computedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "Customer and admin profile documents strictly restricted to owner or admin."
    },
    "/users/{userId}/private/{docId}": {
      "schema": { "$ref": "#/entities/UserPrivateInfo" },
      "description": "Isolated PII subcollection storing email and default shipping address."
    },
    "/admins/{userId}": {
      "schema": { "$ref": "#/entities/Admin" },
      "description": "Trusted store administrator roster for RBAC enforcement."
    },
    "/products/{productId}": {
      "schema": { "$ref": "#/entities/Product" },
      "description": "Publicly readable product catalog; writes restricted to verified admins or atomic order stock updates."
    },
    "/categories/{categoryId}": {
      "schema": { "$ref": "#/entities/Category" },
      "description": "Publicly readable product categories; writes restricted to verified admins."
    },
    "/orders/{orderId}": {
      "schema": { "$ref": "#/entities/Order" },
      "description": "Customer orders readable by owner or admin; status transitions gated."
    },
    "/cart/{cartItemId}": {
      "schema": { "$ref": "#/entities/CartItem" },
      "description": "User-scoped persistent cart items."
    },
    "/wishlist/{wishlistItemId}": {
      "schema": { "$ref": "#/entities/WishlistItem" },
      "description": "User-scoped saved wishlist items."
    },
    "/browsing_history/{historyId}": {
      "schema": { "$ref": "#/entities/BrowsingHistory" },
      "description": "User-scoped product browsing history entries."
    },
    "/recommendations/{userId}": {
      "schema": { "$ref": "#/entities/RecommendationSnapshot" },
      "description": "User-scoped computed recommendation snapshots."
    }
  }
}
